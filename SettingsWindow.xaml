<Window x:Class="Jarvis.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки JARVIS" Width="500" Height="720" Background="#08101C" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" Foreground="#CFEFFF">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#CFEFFF"/><Setter Property="Margin" Value="0,10,0,3"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#CFEFFF"/><Setter Property="Margin" Value="0,8,0,0"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0A1220"/><Setter Property="Foreground" Value="#CFEFFF"/><Setter Property="Padding" Value="5"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0A1220"/><Setter Property="Foreground" Value="#CFEFFF"/><Setter Property="Padding" Value="5"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Foreground" Value="Black"/></Style>
        <Style x:Key="Header" TargetType="TextBlock"><Setter Property="Foreground" Value="#00D4FF"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,18,0,2"/></Style>
        <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#6F93AB"/><Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Голос" Style="{StaticResource Header}" Margin="0,0,0,2"/>
                <TextBlock Text="Микрофон"/><ComboBox x:Name="MicBox"/>
                <TextBlock Text="Устройство вывода звука"/><ComboBox x:Name="OutBox"/>
                <TextBlock Text="Голос"/><ComboBox x:Name="VoiceBox"/>
                <TextBlock Text="Громкость JARVIS"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/>
                <TextBlock Text="Скорость речи (-10 … 10)"/><Slider x:Name="RateSlider" Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"/>

                <TextBlock Text="Ассистент" Style="{StaticResource Header}"/>
                <TextBlock Text="Имя"/><TextBox x:Name="NameBox"/>
                <TextBlock Text="Ключевое слово (одно слово)"/><TextBox x:Name="WakeBox"/>
                <TextBlock Text="Клавиша «зажми и говори»"/><ComboBox x:Name="PttBox"/>
                <CheckBox x:Name="ContinuousCheck" Content="Постоянное прослушивание (иначе — только по кнопке «Говорить»)"/>
                <TextBlock Text="Время ожидания команды, секунд (3–20)"/><Slider x:Name="TimeoutSlider" Minimum="3" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"/>

                <TextBlock Text="Синонимы программ" Style="{StaticResource Header}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                           Text="По строке на программу: «ключ: синоним1, синоним2». Ключ — название программы или имя её процесса (chrome, telegram, steam, explorer, settings…). Добавьте свои слова, например «chrome: гугл, интернет». Встроенные синонимы удалить нельзя."/>
                <TextBox x:Name="SynonymsBox" AcceptsReturn="True" TextWrapping="NoWrap" Height="150"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>

                <TextBlock Text="Языковая модель (LLM)" Style="{StaticResource Header}"/>
                <CheckBox x:Name="LlmCheck" Content="Использовать LLM для сложных фраз"/>
                <TextBlock Text="API (адрес, OpenAI-совместимый)"/><TextBox x:Name="EndpointBox"/>
                <TextBlock Text="Модель"/><TextBox x:Name="ModelBox"/>
                <TextBlock Text="API-ключ (хранится зашифрованно; пусто — не менять)"/><PasswordBox x:Name="KeyBox"/>

                <TextBlock Text="Windows" Style="{StaticResource Header}"/>
                <CheckBox x:Name="AutoStartCheck" Content="Запускать JARVIS вместе с Windows"/>
                <CheckBox x:Name="TrayCheck" Content="Запускать свёрнутым в системный трей"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить" Width="110" Padding="8" Margin="0,0,8,0" IsDefault="True" Click="SaveClick"/>
            <Button Content="Отмена" Width="110" Padding="8" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
